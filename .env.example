# Local PostgreSQL started by scripts/start_postgres.sh
DATABASE_URL=postgresql://localhost:5433/product_search

# Sentence Transformers model (downloaded locally, no API key required)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=0

# Application cache
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=512

# Dataset / import
DATASET_PATH=synthetic_products_100000.csv
